import { Button, VerticalBox, ScrollView } from "std-widgets.slint";
import { TopBar } from "components/topbar.slint";
import { EmptyState } from "components/empty-state.slint";
import { Theme } from "styles/themes.slint";
import { Icons } from "styles/icons.slint";

export struct PdfFile {
    path: string,
    filename: string,
    page-count: int,
}

export struct PageItem {
    source-file: string,
    page-number: int,
    display-text: string,
    preview: image,
}

export component AppWindow inherits Window {
    preferred-width: 900px;
    preferred-height: 600px;

    in-out property <[PdfFile]> pdf-files;
    in-out property <[PageItem]> page-list;

    callback upload-clicked();
    callback delete-page(int);

    VerticalBox {
        spacing: 0px;

        TopBar {
            height: 80px;
            width: 100%;
            upload-clicked => {
                root.upload-clicked();
            }
        }

        Rectangle {
            background: Theme.file-window-background;

            if pdf-files.length == 0: EmptyState {
                upload-clicked => {
                    root.upload-clicked();
                }
            }

            if pdf-files.length > 0: ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    for page[index] in root.page-list: Rectangle {
                        height: 180px;
                        background: Theme.background;
                        border-radius: 8px;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            // Page preview thumbnail
                            Rectangle {
                                width: 120px;
                                background: #f0f0f0;
                                border-radius: 4px;

                                Image {
                                    source: page.preview;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                            }

                            // Page info
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: page.source-file;
                                    font-size: 14px;
                                    font-weight: Theme.font-weight-semibold;
                                    color: Theme.main-font-color;
                                    overflow: elide;
                                }

                                Text {
                                    text: "Page " + page.page-number;
                                    font-size: 12px;
                                    color: Theme.secondary-font-color;
                                }
                            }

                            // Spacer
                            Rectangle { }

                            // Delete button
                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: delete-touch.pressed ? #ffcdd2 : (delete-touch.has-hover ? #ffebee : transparent);

                                    delete-touch := TouchArea {
                                        clicked => {
                                            root.delete-page(index);
                                        }
                                    }

                                    Image {
                                        source: Icons.trash-icon;
                                        width: 20px;
                                        height: 20px;
                                        colorize: delete-touch.has-hover ? #d32f2f : #9e9e9e;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
