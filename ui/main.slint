import { Button, VerticalBox } from "std-widgets.slint";
import { TopBar } from "components/topbar.slint";
import { EmptyState } from "components/empty-state.slint";
import { Theme } from "styles/themes.slint";
import { Icons } from "styles/icons.slint";

export struct PdfFile {
    path: string,
    filename: string,
    page-count: int,
}

export struct PageItem {
    source-file: string,
    page-number: int,
    display-text: string,
    preview: image,
}

global DragConstants {
    out property <length> item-height: 192px; // 180px card + 12px spacing
}

export component AppWindow inherits Window {
    title: "PDF Manager";
    icon: @image-url("images/Logo.png");
    preferred-width: 900px;
    preferred-height: 700px;

    in-out property <[PdfFile]> pdf-files;
    in-out property <[PageItem]> page-list;

    // Drag state
    property <bool> dragging: false;
    property <int> drag-source-index: -1;
    property <int> drag-target-index: -1;

    // Error dialog state
    in-out property <bool> error-visible: false;
    in-out property <string> error-message: "";

    callback upload-clicked();
    callback delete-page(int);
    callback move-page(int, int);
    callback convert-clicked();
    callback clear-clicked();
    callback rotate-page(int);

    VerticalBox {
        spacing: 0px;

        TopBar {
            height: 80px;
            width: 100%;
            upload-clicked => {
                root.upload-clicked();
            }
            convert-clicked => {
                root.convert-clicked();
            }
            clear-clicked => {
                root.clear-clicked();
            }
        }

        Rectangle {
            background: Theme.file-window-background;

            if pdf-files.length == 0: EmptyState {
                upload-clicked => {
                    root.upload-clicked();
                }
            }

            if pdf-files.length > 0: list-flick := Flickable {
                interactive: false;
                viewport-height: 32px + root.page-list.length * DragConstants.item-height;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    for page[index] in root.page-list: Rectangle {
                        height: 180px;
                        background: Theme.background;
                        border-radius: 8px;
                        opacity: root.dragging && root.drag-source-index == index ? 0.4 : 1.0;

                        // Drop indicator line above this item
                        if root.dragging && root.drag-target-index == index && root.drag-source-index != index: Rectangle {
                            y: -8px;
                            height: 3px;
                            background: #2196F3;
                            border-radius: 2px;
                        }

                        // Card-level scroll handler — allows scroll wheel anywhere on the card
                        card-scroll := TouchArea {
                            scroll-event(event) => {
                                list-flick.viewport-y = clamp(
                                    list-flick.viewport-y + event.delta-y,
                                    min(0px, -list-flick.viewport-height + list-flick.height),
                                    0px);
                                return accept;
                            }
                        }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            // Drag handle
                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 28px;
                                    height: 36px;

                                    drag-touch := TouchArea {
                                        mouse-cursor: root.dragging ? grabbing : grab;

                                        scroll-event(event) => {
                                            list-flick.viewport-y = clamp(
                                                list-flick.viewport-y + event.delta-y,
                                                min(0px, -list-flick.viewport-height + list-flick.height),
                                                0px);
                                            if root.dragging {
                                                root.drag-target-index = max(0, min(
                                                    root.page-list.length - 1,
                                                    floor(
                                                        (index * DragConstants.item-height + self.mouse-y + DragConstants.item-height / 2) / DragConstants.item-height)));
                                            }
                                            return accept;
                                        }

                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.left {
                                                if event.kind == PointerEventKind.down {
                                                    root.dragging = true;
                                                    root.drag-source-index = index;
                                                    root.drag-target-index = index;
                                                } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                                    if root.dragging && root.drag-source-index != root.drag-target-index && root.drag-source-index >= 0 && root.drag-target-index >= 0 {
                                                        root.move-page(root.drag-source-index, root.drag-target-index);
                                                    }
                                                    root.dragging = false;
                                                    root.drag-source-index = -1;
                                                    root.drag-target-index = -1;
                                                }
                                            }
                                        }

                                        moved => {
                                            if root.dragging {
                                                root.drag-target-index = max(0, min(
                                                    root.page-list.length - 1,
                                                    floor(
                                                        (index * DragConstants.item-height + self.mouse-y + DragConstants.item-height / 2) / DragConstants.item-height)));
                                            }
                                        }
                                    }

                                    // Drag handle dots
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        padding-left: 8px;
                                        padding-right: 8px;

                                        for dot-row in 3: HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;
                                            Rectangle {
                                                width: 4px;
                                                height: 4px;
                                                border-radius: 2px;
                                                background: drag-touch.has-hover ? #666 : #bbb;
                                            }

                                            Rectangle {
                                                width: 4px;
                                                height: 4px;
                                                border-radius: 2px;
                                                background: drag-touch.has-hover ? #666 : #bbb;
                                            }
                                        }
                                    }
                                }
                            }

                            // Page preview thumbnail
                            Rectangle {
                                width: 120px;
                                background: #f0f0f0;
                                border-radius: 4px;

                                Image {
                                    source: page.preview;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                            }

                            // Page info
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: page.source-file;
                                    font-size: 14px;
                                    font-weight: Theme.font-weight-semibold;
                                    color: Theme.main-font-color;
                                    overflow: elide;
                                }

                                Text {
                                    text: "Page " + page.page-number;
                                    font-size: 12px;
                                    color: Theme.secondary-font-color;
                                }
                            }

                            // Spacer
                            Rectangle { }

                            // Action buttons
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;

                                // Rotate button
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: rotate-touch.pressed ? #bbdefb : (rotate-touch.has-hover ? #e3f2fd : transparent);

                                    rotate-touch := TouchArea {
                                        clicked => {
                                            root.rotate-page(index);
                                        }
                                    }

                                    Image {
                                        source: Icons.rotate-icon;
                                        width: 20px;
                                        height: 20px;
                                        colorize: rotate-touch.has-hover ? #1976D2 : #9e9e9e;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                // Delete button
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: delete-touch.pressed ? #ffcdd2 : (delete-touch.has-hover ? #ffebee : transparent);

                                    delete-touch := TouchArea {
                                        clicked => {
                                            root.delete-page(index);
                                        }
                                    }

                                    Image {
                                        source: Icons.trash-icon;
                                        width: 20px;
                                        height: 20px;
                                        colorize: delete-touch.has-hover ? #d32f2f : #9e9e9e;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Error dialog overlay
    if root.error-visible: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000088;

        TouchArea {
            // Block all clicks
        }

        // Dialog card
        Rectangle {
            width: 400px;
            height: 220px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 12px;

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Error";
                    font-size: 20px;
                    font-weight: 700;
                    color: #d32f2f;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.error-message;
                    font-size: 14px;
                    color: #333;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                // Spacer
                Rectangle { }

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 100px;
                        height: 36px;
                        border-radius: 6px;
                        background: close-touch.pressed ? #b71c1c : (close-touch.has-hover ? #d32f2f : #f44336);

                        close-touch := TouchArea {
                            clicked => {
                                root.error-visible = false;
                            }
                        }

                        Text {
                            text: "Close";
                            color: white;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
